/*
 * GenerateFeatureModel.mwe2
 * ==========================
 * MWE2 (Modeling Workflow Engine) script.
 *
 * HOW TO RUN IN ECLIPSE:
 *   Right-click this file → Run As → MWE2 Workflow
 *
 * WHAT THIS DOES:
 *   1. Reads  FeatureModel.xtext
 *   2. Generates the EMF metamodel      (src-gen/...featureModel/*.java)
 *   3. Generates the ANTLR parser       (src-gen/.../parser/antlr/)
 *   4. Generates the Xtext infrastructure (serializer, formatter, etc.)
 *   5. Generates the Eclipse UI plugin  (org.example.poc.ui)
 *
 * You must run this ONCE after creating or modifying the grammar.
 * After that, the generated code lives in src-gen/ and model/.
 */
module org.example.poc.GenerateFeatureModel

import org.eclipse.xtext.xtext.generator.*
import org.eclipse.xtext.xtext.generator.model.project.*

var rootPath = ".."

Workflow {
    component = XtextGenerator {
        configuration = {
            project = StandardProjectConfig {
                baseName = "org.example.poc"
                rootPath = rootPath
                runtimeTest = {
                    enabled = false
                }
                eclipsePlugin = {
                    enabled = true
                }
                createEclipseMetaData = true
            }
            code = {
                encoding = "UTF-8"
                lineDelimiter = "\n"
                fileHeader = "/*\n * generated by Xtext \${version}\n */"
                preferXtendStubs = true
            }
        }
        language = StandardLanguage {
            name = "org.example.poc.FeatureModel"
            fileExtensions = "fm"

            // Use the default Xtext serializer
            serializer = {
                generateStub = false
            }

            // Generate the Xtext validator stub
            validator = {
                composedCheck = "org.eclipse.xtext.validation.NamesAreUniqueValidator"
            }

            // Wire in our custom generator
            generator = {
                generateStub = false
            }
        }
    }
}
